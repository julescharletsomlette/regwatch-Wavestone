# Gabarit de configuration. Copier en .env et renseigner.
# Le vrai fichier n'est jamais versionne : voir .gitignore.

# --- Azure OpenAI : score et analyse des items collectes -------------------
# Necessaire pour agent-veille/collect.py et agent-veille/translate_items.py.
# La meme cle est configuree cote proxy Azure, ou elle sert a l'assistant de
# la page. Verifier la configuration : python3 agent-veille/check_azure.py
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<ressource>.services.ai.azure.com
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- SharePoint : synchronisation du classeur, en lecture seule ------------
# Le lien « Copier le lien » du classeur dans SharePoint.
SHAREPOINT_FILE_URL=

# Facultatif : deduit du lien si absent.
# Retrouvable avec : ./venv/bin/python tools/sharepoint_fetch.py --check "<lien>"
GRAPH_TENANT_ID=

# Seulement apres creation de l'inscription d'application par l'IT.
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
